PORT=5000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=

# ===================== AWS (Bedrock guilt notifications + SES emails) =====================
# See README/AWS_AND_REVENUECAT_SETUP.md for step-by-step instructions.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: a Bedrock API key can replace the IAM keys for Bedrock only (SES still needs IAM keys)
# AWS_BEARER_TOKEN_BEDROCK=
# Open-source lightweight model (Meta Llama 3.2 3B Instruct). Change to any Bedrock text model id.
BEDROCK_MODEL_ID=us.meta.llama3-2-3b-instruct-v1:0
# SES (email) - region can differ from Bedrock
AWS_SES_REGION=us-east-1
# Must be a verified identity in SES, e.g. noreply@yourdomain.com
SES_FROM_EMAIL=
SES_REPLY_TO=

# ===================== RevenueCat (payments) =====================
# Secret API key (v1) from RevenueCat -> Project settings -> API keys -> "Secret API keys"
REVENUECAT_SECRET_API_KEY=
# Any random string you choose; paste the SAME value in the RevenueCat webhook "Authorization header" field
REVENUECAT_WEBHOOK_AUTH=
# Entitlement identifier you created in RevenueCat
REVENUECAT_ENTITLEMENT_ID=pro

# ===================== Admin =====================
# Random string; required header (x-admin-key) for POST /api/admin/app-update-email
ADMIN_API_KEY=
